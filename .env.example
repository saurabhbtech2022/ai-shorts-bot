# YouTube OAuth (from Google Cloud Console)
YT_CLIENT_ID=your-client-id.apps.googleusercontent.com
YT_CLIENT_SECRET=your-client-secret
YT_REFRESH_TOKEN=your-refresh-token-from-scripts/get_refresh_token.py

# Cloudflare Workers AI (primary image provider)
CF_ACCOUNT_ID=your-cloudflare-account-id
CF_API_TOKEN=your-cloudflare-api-token-with-workers-ai

# Pollinations (disabled by default — set ENABLE_POLLINATIONS=true to use)
ENABLE_POLLINATIONS=false
POLLINATIONS_FREE_FALLBACK=false
POLLINATIONS_API_KEY=

# FastAPI protection (any strong random string)
API_KEY=change-me-to-a-long-random-secret

# Three uploads per day (Asia/Kolkata): subah / dopahar / sham
UPLOAD_TIME_MORNING=08:00
UPLOAD_TIME_AFTERNOON=13:00
UPLOAD_TIME_EVENING=18:00
TIMEZONE=Asia/Kolkata
RUN_SCHEDULER=false

# One scene → one 5 second Short per run (run 3× daily with --slot)
SCENES_PER_RUN=1
VIDEO_DURATION=15
SCENE_SLIDE_SECONDS=15
SLIDESHOW_CROSSFADE_SECONDS=0.5
PRIVACY_STATUS=public
ENABLE_VOICEOVER=true
TTS_ENGINE=edge
TTS_VOICE=hi-IN-MadhurNeural
TTS_RATE=+5%
TTS_PITCH=-2Hz
TTS_FALLBACK_GTTS=false
ENABLE_TEXT_OVERLAY=true
ENABLE_PART_BADGE=true
PART_BADGE_CORNER=right
ENABLE_SUBSCRIBE_CTA=true
SUBSCRIBE_CTA_SECONDS=4
SUBSCRIBE_CTA_OVERLAY=अगले भाग के लिए सब्सक्राइब करें
SUBSCRIBE_CTA_OVERLAY_SUB=घंटी दबाएँ — नोटिफिकेशन ऑन करें
SUBSCRIBE_CTA_VOICE=चैनल सब्सक्राइब करें, अगला भाग मत चूकिए।
IMAGE_STYLE_SUFFIX=, divine, cinematic lighting, highly detailed, traditional Indian art style, respectful depiction
CHANNEL_HASHTAGS=#Ramayan #Mahabharat #Shorts #Hindu #Itihas #AIart
